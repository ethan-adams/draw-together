# Copy to .env and fill in. Both are required.

# Public domain this instance serves. Caddy gets an HTTPS certificate for it
# automatically — point the domain's DNS (an A record) at this server's public
# IP before starting.
DRAW_DOMAIN=board.example.com

# Password for the bundled Postgres. Use a long random string, e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string
